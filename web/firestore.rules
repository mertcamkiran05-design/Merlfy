rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /memos/{memoId} {
      allow read: if resource.data.visibility in ["workspace","public"]
                   || (request.auth != null && request.auth.uid == resource.data.userId);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /resources/{resId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    match /scores/{scoreId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    match /settings/global {
      allow read: if true;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "owner";
    }

    match /chessGames/{gameId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.whiteId == request.auth.uid
        && request.resource.data.blackId == null
        && request.resource.data.status == "waiting";
      allow update: if request.auth != null && (
        (resource.data.status == "waiting" && resource.data.blackId == null
          && request.resource.data.blackId == request.auth.uid
          && request.resource.data.whiteId == resource.data.whiteId)
        || (resource.data.whiteId == request.auth.uid || resource.data.blackId == request.auth.uid)
      );
      allow delete: if request.auth != null
        && resource.data.whiteId == request.auth.uid && resource.data.blackId == null;
    }
  }
}
